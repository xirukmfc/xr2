{
  "name": "n8n-nodes-xr2",
  "version": "0.2.21",
  "description": "n8n community nodes for xR2 API (Check API Key, Get Prompt, Track Events)",
  "license": "MIT",
  "author": {
    "name": "xirukmfc",
    "email": "pavel.kuzko@gmail.com"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n-community-node",
    "n8n-nodes",
    "xr2",
    "prompts",
    "analytics"
  ],
  "homepage": "https://github.com/xirukmfc/n8n-nodes-xr2#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xirukmfc/n8n-nodes-xr2.git"
  },
  "bugs": {
    "email": "hello@xr2.uk"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "nodes": [
      "dist/nodes/XR2/Xr2.node.js"
    ],
    "credentials": [
      "dist/credentials/XR2Api.credentials.js"
    ]
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "@types/node": "^20.11.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "release-it": "^19.2.4",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
