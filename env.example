# xR2 Platform Environment Configuration
# ======================================
#
# Скопируйте этот файл в .env и заполните реальными значениями.
# НИКОГДА не коммитьте .env в репозиторий.

# Database Configuration
POSTGRES_PASSWORD=<CHANGE_ME_strong_random_password>
DATABASE_URL=postgresql://xr2_user:<CHANGE_ME_strong_random_password>@postgres:5432/xr2_db

# Redis Configuration
REDIS_PASSWORD=<CHANGE_ME_strong_random_password>
REDIS_URL=redis://:<CHANGE_ME_strong_random_password>@redis:6379/0

# Security Configuration (минимум 32 символа, случайная строка)
SECRET_KEY=<CHANGE_ME_random_32_plus_chars>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<CHANGE_ME_strong_random_password>
ADMIN_EMAIL=admin@example.com

# OAuth Configuration (Google)
GOOGLE_CLIENT_ID=<your_google_client_id>
GOOGLE_CLIENT_SECRET=<your_google_client_secret>
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<your_google_client_id>

# UI Configuration
# Set to 'true' to enable password login form in UI (for testing/development)
# Set to 'false' to hide password login form (production - only Google OAuth)
NEXT_PUBLIC_ENABLE_PASSWORD_LOGIN=false

# API Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100
MAX_REQUESTS_PER_IP_PER_MINUTE=100
MAX_REQUESTS_PER_API_KEY_PER_MINUTE=1000

# Environment
ENVIRONMENT=production
DEBUG=false

# CORS Configuration
CORS_ORIGINS=*

# Monitoring
GRAFANA_PASSWORD=<CHANGE_ME_strong_random_password>

# SSL Configuration (для production)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=/app/logs/app.log

# Email Configuration (для уведомлений)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@yourdomain.com

# External API Configuration
EXTERNAL_API_BASE_URL=https://api.yourdomain.com
EXTERNAL_API_TIMEOUT=30

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"  # Каждый день в 2:00

# Performance Configuration
WORKER_PROCESSES=4
MAX_CONNECTIONS=1000
TIMEOUT=30
